# Reference only: ASP.NET Core does not automatically read this file.
# Use Visual Studio user secrets for local development.
ConnectionStrings__DefaultConnection=
Jwt__Issuer=RecipeHub
Jwt__Audience=RecipeHub.Web
Jwt__Key=
Cors__AllowedOrigins__0=http://localhost:3000
# Frontend startup session restore is off for local testing.
# Compose reads this as a build argument. Rebuild the frontend after changing it.
# For npm dev, set it in frontend/.env.local and restart the dev server.
NEXT_PUBLIC_RESTORE_SESSION=false
